{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/mobile-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Bricolage Grotesque|Instrument Sans))/i]",
        "message": "Font not provided by the design system. Available: Bricolage Grotesque, Instrument Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|confirmed|solid|on-dark)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'confirmed' | 'solid' | 'on-dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|onDark|fullWidth|disabled|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, onDark, fullWidth, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|pad|texture|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: tone, pad, texture, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:white|raised|dark|dark-raised)$/]",
        "message": "<Card> tone must be one of 'white' | 'raised' | 'dark' | 'dark-raised'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IncludedRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|onDark|style|key|ref|className|style|children)$/]",
        "message": "<IncludedRow> doesn't accept that prop. Declared props: children, size, onDark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|as|leading|onDark|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, as, leading, onDark."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:input|textarea)$/]",
        "message": "<Input> as must be one of 'input' | 'textarea'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LightTrail'] > JSXAttribute > JSXIdentifier[name!=/^(?:height|labels|animate|style|key|ref|className|style|children)$/]",
        "message": "<LightTrail> doesn't accept that prop. Declared props: height, labels, animate, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:leading|title|subtitle|trailing|chevron|onDark|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ListRow> doesn't accept that prop. Declared props: leading, title, subtitle, trailing, chevron, onDark, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|showText|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, size, showText, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:navy|white)$/]",
        "message": "<Logo> variant must be one of 'navy' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NameSign'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|line|foot|style|key|ref|className|style|children)$/]",
        "message": "<NameSign> doesn't accept that prop. Declared props: name, line, foot, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceDisplay'] > JSXAttribute > JSXIdentifier[name!=/^(?:amount|caption|size|onDark|align|key|ref|className|style|children)$/]",
        "message": "<PriceDisplay> doesn't accept that prop. Declared props: amount, caption, size, onDark, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceDisplay'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<PriceDisplay> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RouteChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:from|to|onDark|size|key|ref|className|style|children)$/]",
        "message": "<RouteChip> doesn't accept that prop. Declared props: from, to, onDark, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='RouteChip'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<RouteChip> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabBarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|key|ref|className|style|children)$/]",
        "message": "<TabBarItem> doesn't accept that prop. Declared props: label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='TripStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|detail|key|ref|className|style|children)$/]",
        "message": "<TripStep> doesn't accept that prop. Declared props: title, detail."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
