# Same Supabase project as the website (trip is one record, two surfaces)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxx

# No Google Maps key here, on purpose. Address autocomplete goes through the
# `places` Edge Function, which holds the key server-side as a Supabase secret:
#
#   supabase secrets set GOOGLE_PLACES_KEY=<key> --project-ref <ref>
#
# A key in this file would ship inside the bundle, where the only protection is a
# Google app restriction — and that cannot be made to work for Android without
# putting the release signing SHA-1 in JS. Until the secret is set, autocomplete
# degrades to a plain text box and booking is unaffected.

